# Caddyfile for Receipt.ai
# Replace {$DOMAIN} with your actual domain in production

{$DOMAIN:localhost} {
    # Automatic HTTPS with Let's Encrypt (production)
    # For localhost, Caddy uses a local CA

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # API routes -> Backend
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Health check endpoint
    handle /health {
        reverse_proxy backend:8000
    }

    # Static frontend files
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Redirect www to non-www (if using a domain)
www.{$DOMAIN:localhost} {
    redir https://{$DOMAIN}{uri} permanent
}
