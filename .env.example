# Receipt.ai Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Security Keys
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-32-byte-encryption-key-here
SECRET_KEY=your-secret-key-here

# ============================================
# REQUIRED: Database
# ============================================
POSTGRES_USER=receipt
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=receipt

# ============================================
# OPTIONAL: Redis Password (recommended for production)
# ============================================
REDIS_PASSWORD=

# ============================================
# REQUIRED FOR PRODUCTION: Domain Configuration
# ============================================
# Your domain where the app will be hosted
DOMAIN=receipts.yourdomain.com
BACKEND_URL=https://receipts.yourdomain.com
FRONTEND_URL=https://receipts.yourdomain.com

# ============================================
# OAUTH: Google (Gmail API)
# ============================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project
# 3. Enable Gmail API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add redirect URI: https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# OAUTH: Microsoft (Graph API)
# ============================================
# Get these from Azure Portal (Entra ID):
# 1. Go to https://portal.azure.com/
# 2. Navigate to Azure Active Directory > App registrations
# 3. Create new registration
# 4. Add redirect URI: https://your-domain/api/auth/microsoft/callback
# 5. Create a client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ============================================
# OPTIONAL: LLM (OpenAI) for enhanced extraction
# ============================================
# Enable for better extraction when rules-based has low confidence
OPENAI_API_KEY=
LLM_ENABLED=false
